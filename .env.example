# Copy this file to ".env" and fill in your own keys.
# Never commit your real .env file anywhere.

# Adzuna gives the best India + remote job coverage of the free APIs.
# Get free keys at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional. Only needed if you want to override Ollama's defaults.
# Leave blank to use http://localhost:11434 and the default model (llama3.2:3b).
# No API key needed — cover letter drafting runs fully locally via Ollama.
# Install Ollama: https://ollama.com then run: ollama pull llama3.2:3b
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2:3b
